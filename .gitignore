# Environments
.venv/
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Data — raw is immutable and never committed; everything downstream regenerates from it.
# Directory contents are ignored but the .gitkeep files are not, so the tree exists on a
# clean checkout and the pipeline has somewhere to write on first run.
data/raw/*
!data/raw/.gitkeep
!data/raw/cache/
data/raw/cache/*
!data/raw/cache/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Spot-check sheets carry real listing values (price, area, locality) for 30 properties.
# Ilaan publishes no licence to redistribute its listings (D-14, D-23), so the sheets stay
# local. The .meta.json provenance files carry no listing data and are committed, and the
# accuracy result is recorded in project-log/decisions/02-acquisition.md.
reports/*.csv

# Personal working notes, not a project deliverable. LESSONS.md collects process lessons for
# Nauman to triage into his own working instructions at project close; it records his
# decisions and Claude's mistakes candidly, which is what makes it useful and what makes it
# unsuitable for a public repository. Kept local, versioned by nothing — back it up separately.
project-log/LESSONS.md
